# Copia este archivo como .env antes de ejecutar "docker compose up"

# --- Base de datos ---
MYSQL_HOST=db
MYSQL_PORT=3307
MYSQL_DATABASE=clinica_veterinaria
MYSQL_USER=clinica
MYSQL_PASSWORD=clinica
MYSQL_ROOT_PASSWORD=root

# --- Apache + PHP ---
APACHE_PORT=8080
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=60
PHP_UPLOAD_MAX_FILESIZE=10M
PHP_POST_MAX_SIZE=12M

# --- phpMyAdmin ---
PHPMYADMIN_PORT=8081
PMA_HOST=db
PMA_USER=root
PMA_PASSWORD=root
