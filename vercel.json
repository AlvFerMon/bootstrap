{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "www/**"
    }
  },
  "routes": [
    {
      "src": "/(.+\\.(css|js|png|jpe?g|gif|webp|svg|ico|woff2?))",
      "dest": "/www/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
